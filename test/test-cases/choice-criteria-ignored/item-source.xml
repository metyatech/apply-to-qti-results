<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item
    xmlns="http://www.imsglobal.org/xsd/imsqti_v3p0"
    identifier="item-1"
    title="Choice Item"
    adaptive="false"
    time-dependent="false">
  <qti-response-declaration identifier="RESPONSE" cardinality="single" base-type="identifier">
    <qti-correct-response>
      <qti-value>CHOICE_1</qti-value>
    </qti-correct-response>
  </qti-response-declaration>
  <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float"/>
  <qti-outcome-declaration identifier="MAXSCORE" cardinality="single" base-type="float">
    <qti-default-value>
      <qti-value>1</qti-value>
    </qti-default-value>
  </qti-outcome-declaration>
  <qti-item-body>
    <qti-choice-interaction response-identifier="RESPONSE" max-choices="1">
      <qti-simple-choice identifier="CHOICE_1">Correct</qti-simple-choice>
      <qti-simple-choice identifier="CHOICE_2">Wrong</qti-simple-choice>
    </qti-choice-interaction>
    <qti-rubric-block view="scorer">
      <p>[1] Selected the correct choice</p>
    </qti-rubric-block>
  </qti-item-body>
</qti-assessment-item>
