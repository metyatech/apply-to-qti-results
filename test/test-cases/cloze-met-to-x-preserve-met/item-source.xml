<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item
    xmlns="http://www.imsglobal.org/xsd/imsqti_v3p0"
    identifier="item-1"
    title="Cloze Item"
    adaptive="false"
    time-dependent="false">
  <qti-response-declaration identifier="RESPONSE" cardinality="single" base-type="string">
    <qti-correct-response>
      <qti-value>correct</qti-value>
    </qti-correct-response>
  </qti-response-declaration>
  <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float"/>
  <qti-outcome-declaration identifier="MAXSCORE" cardinality="single" base-type="float">
    <qti-default-value>
      <qti-value>2</qti-value>
    </qti-default-value>
  </qti-outcome-declaration>
  <qti-item-body>
    <qti-text-entry-interaction response-identifier="RESPONSE" expected-length="10"/>
    <qti-rubric-block view="scorer">
      <p>[2] Entered the correct text</p>
    </qti-rubric-block>
  </qti-item-body>
</qti-assessment-item>
